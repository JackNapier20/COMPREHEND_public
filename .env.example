# Copy to .env and fill in your credentials.
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
TOGETHER_API_KEY=...
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
TOGETHER_MAX_TOKENS=4096
TOGETHER_EMPTY_RETRY_MAX_TOKENS=16384
TOGETHER_CONCURRENCY=8
TOGETHER_REASONING_EFFORT=low
# OpenAI-compatible endpoint serving the finetuned local model (e.g. vLLM)
GEMMA_API_KEY=DUMMY
GEMMA_BASE_URL=http://<GPU_HOST>:8000/v1
GEMMA_MODEL=<PATH_OR_NAME_REGISTERED_BY_YOUR_VLLM_SERVER>
GEMMA_WAIT_SECONDS=600
GEMMA_TIMEOUT_SECONDS=600
GEMMA_MAX_TOKENS=1024
GEMMA_MAIN_IDEA_MAX_TOKENS=1024
# 1 uses individual text extraction without requiring JSON output.
GEMMA_MAIN_IDEA_BATCH_SIZE=1
GEMMA_CONCURRENCY=8
